{
  "name": "obcowa",
  "version": "0.18.3",
  "description": "Obsidianを母艦として、プロジェクトごとにワークスペースを構成できるMarkdownエディタ",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/generate_licenses.js",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "doc:map": "node scripts/generate_filemap.js",
    "prepare": "git config core.hooksPath .githooks"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "diff": "^9.0.0",
    "dompurify": "^3.4.12",
    "lucide-svelte": "^1.0.1",
    "marked": "^18.0.5",
    "mermaid": "^11.17.2",
    "moo": "^0.5.3",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/svelte": "^5.4.2",
    "@types/diff": "^7.0.2",
    "@types/dompurify": "^3.0.5",
    "jsdom": "^29.1.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
